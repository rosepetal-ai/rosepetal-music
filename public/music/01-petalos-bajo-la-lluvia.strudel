// Rosepetal Music · 01 · Pétalos bajo la lluvia
// Ambiental lo-fi, 75 BPM, La menor / Do mayor. Instrumental, con un aire Nujabes (flauta, piano troceado, acordes de 7.ª y 9.ª).
// Bucle de 16 compases (1 ciclo = 1 compás, ~51 s):
//   1–4 lluvia, piano, pad y arpegio · 5–8 entran la batería suave y una frase de flauta · 9–16 groove completo, melodía y segunda flauta.
// Reverb con un solo tamaño (sala 4) y el arpegio en su propio canal de eco (orbit 2): si cambian dentro de un canal, el audio se corta.
// Armonía (2 compases por acorde): Fa maj9 | Mi m7 | Re m9 | La m9.
// El piano es un acorde de Do mayor (SFXMint) transpuesto con speed: Do (1) · Sol (0,7492) · Fa (0,6674); el pad pone las 3.ª, 7.ª y 9.ª.
// La flauta (SFXMint) es un Do5; speed = 2^(semitonos/12): Mi4 0,63 · Fa4 0,6674 · Sol4 0,7492 · La4 0,8409 · Si4 0,9439 · Do5 1 · Re5 1,1225 · Mi5 1,2599.
stack(
  // Lluvia en la ventana (SFXMint, 10 s): una toma cada 3 compases, se solapan ~0,4 s
  s("sfx_ambience_rain_21").slow(3).hpf(300).lpf(5200).gain(0.15),
  // Crepitar de chimenea muy filtrado, como polvo de vinilo (SFXMint, 11 s)
  s("sfx_ambience_fireplace_42").slow(3).late(1.5).hpf(1800).lpf(7000).gain(0.13),
  // Pad de piano eléctrico (FM suave, vibrato lento de cinta): 3.ª, 7.ª y 9.ª de cada acorde
  note("<[a3,e4,g4]!2 [g3,d4,f#4]!2 [f3,c4,e4]!2 [c4,g4,b4]!2>").s("triangle").fmh(1).fmi(0.7)
    .attack(0.3).decay(2).sustain(0.55).release(2.5).lpf(1900).vib(0.25).vibmod(0.08)
    .room(0.5).size(4).gain(0.14),
  // Bajo redondo que camina hacia el acorde siguiente
  note("<[f2@3 [~ a2]] [f2@2 c3 e2] [e2@3 [~ g2]] [e2@2 b2 d2] [d2@3 [~ f2]] [d2@2 a2 a1] [a1@3 [~ c2]] [a1@2 e2 g2]>").s("sine")
    .attack(0.03).decay(0.7).sustain(0.6).release(0.5).lpf(420).gain(0.36),
  // Acorde de piano (SFXMint) troceado: dos golpes por compás, a contratiempo en el segundo
  s("<[sfx_piano_major_chord_01 ~ [~ sfx_piano_major_chord_01] ~] [~ [~ sfx_piano_major_chord_01] ~ sfx_piano_major_chord_01]>").speed("<1!2 0.7492!2 0.6674!2 1!2>")
    .gain("<[0.44 0.28] [0.3 0.24]>").hpf(120).lpf(2700).room(0.45).size(4).pan("<0.45 0.55>"),
  // Arpegio de campanita (seno con pulsación corta), notas del acorde, con eco; alguna nota se cae al azar
  note("<[c5 ~ g5 ~ ~ e5 ~ ~]!2 [b4 ~ g5 ~ ~ d5 ~ ~]!2 [a4 ~ e5 ~ ~ c5 ~ ~]!2 [e5 ~ b5 ~ ~ g5 ~ ~]!2>").s("sine")
    .attack(0.005).decay(0.35).sustain(0).degradeBy(0.25).orbit(2).delay(0.35).delaytime(0.6).delayfeedback(0.45)
    .room(0.6).size(4).pan(sine.range(0.3, 0.7).slow(8)).gain(0.06),
  // Flauta principal (SFXMint): frase corta en 5–8 y melodía completa en 9–16
  s("<~!4 [~ ~ sfx_flute_note_01@2] [sfx_flute_note_01@4] [~ ~ sfx_flute_note_01@2] [sfx_flute_note_01@3 ~] [~ ~ sfx_flute_note_01@2] [sfx_flute_note_01@3 sfx_flute_note_01] [~ sfx_flute_note_01@3] [sfx_flute_note_01@4] [~ sfx_flute_note_01 sfx_flute_note_01@2] [sfx_flute_note_01@3 ~] [~ ~ sfx_flute_note_01 sfx_flute_note_01] [sfx_flute_note_01@3 ~]>")
    .speed("<~!4 [~ ~ 0.8409@2] [1@4] [~ ~ 1.2599@2] [1.1225@3 ~] [~ ~ 1.2599@2] [1.1225@3 1] [~ 0.9439@3] [0.7492@4] [~ 0.8409 1@2] [1.2599@3 ~] [~ ~ 1.1225 1] [0.8409@3 ~]>")
    .clip(1).attack(0.06).release(0.9).hpf(250).lpf(3400)
    .delay(0.22).delaytime(0.6).delayfeedback(0.35).room(0.7).size(4).pan(0.4).gain(0.32),
  // Segunda flauta en 9–16: la misma frase una tercera por debajo, más lejos y al otro lado
  s("<~!8 [~ ~ sfx_flute_note_01@2] [sfx_flute_note_01@3 sfx_flute_note_01] [~ sfx_flute_note_01@3] [sfx_flute_note_01@4] [~ sfx_flute_note_01 sfx_flute_note_01@2] [sfx_flute_note_01@3 ~] [~ ~ sfx_flute_note_01 sfx_flute_note_01] [sfx_flute_note_01@3 ~]>")
    .speed("<~!8 [~ ~ 1@2] [0.9439@3 0.8409] [~ 0.7492@3] [0.63@4] [~ 0.6674 0.8409@2] [1@3 ~] [~ ~ 0.9439 0.8409] [0.63@3 ~]>")
    .clip(1).attack(0.08).release(1).hpf(300).lpf(2600).room(0.85).size(4).pan(0.66).gain(0.17),
  // Campanillas al final de cada mitad, muy lejos
  s("<~!3 [~ ~ sfx_wind_chimes_settle_01 ~] ~!3 [~ ~ sfx_wind_chimes_settle_01 ~] ~!7 [~ ~ sfx_wind_chimes_settle_01 ~]>").hpf(2500).room(0.8).size(4).pan(0.72).gain(0.08),
  // Bombo apagado: sencillo en 5–8, con un golpe más en 9–16
  s("<~!4 [sbd ~ ~ ~ ~ ~ ~ ~ ~ ~ sbd ~ ~ ~ ~ ~]!4 [sbd ~ ~ ~ ~ ~ ~ sbd ~ ~ sbd ~ ~ ~ ~ ~]!8>").decay(0.45).lpf(280).gain(0.46),
  // Caja de escobilla (ruido corto filtrado + cuerpo grave) en el 2 y el 4; golpes fantasma en 9–16
  s("<~!4 [~ white ~ white]!4 [~ white ~ [white ~ ~ white]]!8>").decay(0.12).sustain(0).hpf(1000).lpf(4500)
    .gain("<0!4 0.1!4 [0.12 0.12 0.12 [0.12 0.04]]!8>").room(0.3).size(4),
  s("<~!4 [~ brown ~ brown]!12>").decay(0.14).sustain(0).lpf(1100).gain(0.12),
  // Charles a corcheas con swing, casi susurrados (más suaves en 5–8)
  s("<~!4 [pink*8]!12>").decay(0.025).sustain(0).hpf(7500).gain("<0!4 [0.03 0.018]!4 [0.05 0.028]!8>").swingBy(1/3, 4)
).cpm(75 / 4)
